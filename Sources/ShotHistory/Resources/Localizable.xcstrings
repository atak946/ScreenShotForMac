            "value": "Tümü"
          }
        }
      }
    },
    "All captures and recordings stored in history will be deleted. This cannot be undone.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçmişte saklanan tüm yakalamalar ve kayıtlar silinecek. Bu işlem geri alınamaz."
          }
        }
      }
    },
