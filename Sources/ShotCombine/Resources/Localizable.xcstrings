    "Click the image to add a split line. Drag lines to move them.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bölme çizgisi eklemek için görsele tıklayın. Taşımak için çizgileri sürükleyin."
          }
        }
      }
    },
    "Click the preview to add a line; hover a line to remove it.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çizgi eklemek için önizlemeye tıklayın; kaldırmak için imleci çizginin üzerine getirin."
          }
        }
      }
    },
