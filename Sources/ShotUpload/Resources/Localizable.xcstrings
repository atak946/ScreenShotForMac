      }
    },
    "%@ must be a valid http(s) URL.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ geçerli bir http(s) URL'si olmalıdır."
          }
        }
      }
    },
