    "Secret Access Key": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizli Erişim Anahtarı"
          }
        }
      }
    },
    "Send captures to any HTTP endpoint, like a ShareX custom uploader.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakalamaları, ShareX özel yükleyicisi gibi herhangi bir HTTP uç noktasına gönderin."
          }
        }
      }
    },
    "Storage": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Depolama"
          }
        }
      }
    },
    "Test Upload": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüklemeyi Test Et"
          }
        }
      }
    },
    "The regular expression is not valid.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düzenli ifade geçerli değil."
          }
        }
      }
    },
    "The response did not contain a link.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanıt bir bağlantı içermiyor."
          }
        }
      }
    },
    "The response link is not a valid URL.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanıttaki bağlantı geçerli bir URL değil."
          }
        }
      }
    },
    "The secret access key is stored in your Keychain.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizli erişim anahtarı Anahtar Zinciri'nizde saklanır."
          }
        }
      }
    },
    "The server returned an invalid response.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu geçersiz bir yanıt döndürdü."
          }
        }
      }
    },
    "Upload": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yükleme"
          }
        }
      }
    },
    "Uploads a tiny 1×1 image to check your settings.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlarınızı denetlemek için 1×1 boyutunda küçük bir görüntü yükler."
          }
        }
      }
    },
    "Use dots for nested keys and numbers for array items, e.g. files.0.url. A regular expression returns its first capture group.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İç içe anahtarlar için nokta, dizi öğeleri için sayı kullanın; örn. files.0.url. Düzenli ifade ilk yakalama grubunu döndürür."
          }
        }
      }
    },
    "Use path-style URLs": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yol stili URL'ler kullan"
          }
        }
      }
    },
    "Value": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değer"
          }
        }
      }
    },
    "Values marked Secret are stored in your Keychain.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizli olarak işaretlenen değerler Anahtar Zinciri'nizde saklanır."
          }
        }
      }
    },
    "Works with AWS S3, Cloudflare R2, MinIO, Backblaze B2 and other S3-compatible storage.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AWS S3, Cloudflare R2, MinIO, Backblaze B2 ve diğer S3 uyumlu depolama hizmetleriyle çalışır."
          }
        }
      }
    },
    "{date} becomes year/month/day. Set a public URL to share links through a custom domain or CDN; leave it empty to use the bucket URL.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "{date} yıl/ay/gün olur. Bağlantıları özel bir alan adı veya CDN üzerinden paylaşmak için herkese açık bir URL belirleyin; bucket URL'sini kullanmak için boş bırakın."
          }
        }
      }
    }
  },
  "version": "1.0"
}