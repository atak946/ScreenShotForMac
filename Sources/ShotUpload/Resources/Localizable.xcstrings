        }
      }
    },
    "Cloudflare R2 uses the region \"auto\". MinIO usually needs path-style URLs.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare R2 \"auto\" bölgesini kullanır. MinIO genellikle yol stili URL'ler gerektirir."
