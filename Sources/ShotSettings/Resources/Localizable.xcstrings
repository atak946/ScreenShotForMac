        }
      }
    },
    "Arrows, text, highlights and blur in a fast editor.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hızlı bir düzenleyicide oklar, metin, vurgular ve bulanıklaştırma."
