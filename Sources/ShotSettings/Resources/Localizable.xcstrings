      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakalamadan sonra"
          }
        }
      }
    },
    "After enabling it, macOS may ask you to quit and reopen the app.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzni etkinleştirdikten sonra macOS, uygulamadan çıkıp yeniden açmanızı isteyebilir."
          }
        }
      }
    },
    "After granting Screen Recording, macOS may ask you to quit and reopen the app.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran Kaydı iznini verdikten sonra macOS, uygulamadan çıkıp yeniden açmanızı isteyebilir."
          }
        }
      }
    },
    "All processing happens on your Mac. No telemetry.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm işlemler Mac'inizde gerçekleşir. Telemetri yok."
          }
        }
      }
    },
    "Allow Screen Recording": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran Kaydına İzin Ver"
