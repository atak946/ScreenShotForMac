        }
      }
    },
    "Allow…": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzin Ver…"
          }
        }
      }
    },
    "Already allowed? macOS applies it after a restart.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzin verdin mi? macOS bunu yeniden başlatınca uygular."
