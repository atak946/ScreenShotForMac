{
  "sourceLanguage": "en",
  "strings": {
    "Choose": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seç"
          }
        }
      }
    },
    "Choose where screenshots are saved": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran görüntülerinin kaydedileceği yeri seçin"
          }
        }
      }
    },
    "Close": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapat"
          }
        }
      }
    },
    "Copy": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopyala"
          }
        }
      }
    },
    "Could not encode the image as %@.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görüntü %@ olarak kodlanamadı."
          }
        }
      }
    },
    "Could not resize the image.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görüntü yeniden boyutlandırılamadı."
          }
        }
      }
    },
    "Could not write the file to %@: %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya %1$@ konumuna yazılamadı: %2$@"
          }
        }
      }
    },
    "Edit": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düzenle"
          }
        }
      }
    },
    "Format:": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Biçim:"
          }
        }
      }
    },
    "Pin": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabitle"
          }
        }
      }
    },
    "Save": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydet"
          }
        }
      }
    },
    "Save Screenshot": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran Görüntüsünü Kaydet"
          }
        }
      }
    },
    "Screenshot preview": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran görüntüsü önizlemesi"
          }
        }
      }
    },
    "The save folder is not accessible: %@. Choose another folder in Settings.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt klasörüne erişilemiyor: %@. Ayarlar'dan başka bir klasör seçin."
          }
        }
      }
    },
    "The saved folder could not be resolved: %@. Choose the folder again in Settings.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı klasör çözümlenemedi: %@. Klasörü Ayarlar'dan yeniden seçin."
          }
        }
      }
    },
    "Upload": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yükle"
          }
        }
      }
    }
  },
  "version": "1.0"
}