{
  "sourceLanguage": "en",
  "strings": {
    "A spooled GIF frame could not be read.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ara belleğe alınan bir GIF karesi okunamadı."
          }
        }
      }
    },
    "Accessibility access": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişilebilirlik izni"
          }
        }
      }
    },
    "Allow…": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzin Ver…"
          }
        }
      }
    },
    "Audio is not available for GIF recordings": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF kayıtlarında ses kullanılamaz"
          }
        }
      }
    },
    "Camera access is denied. Allow it in System Settings > Privacy & Security > Camera.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera erişimi reddedildi. Sistem Ayarları > Gizlilik ve Güvenlik > Kamera bölümünden izin verin."
          }
        }
      }
    },
    "Camera: Off": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera: Kapalı"
          }
        }
      }
    },
    "Camera: On": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera: Açık"
          }
        }
      }
    },
    "Cannot create GIF file.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF dosyası oluşturulamıyor."
          }
        }
      }
    },
    "Cannot create GIF frame folder: %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF kare klasörü oluşturulamıyor: %@"
          }
        }
      }
    },
    "Cannot create movie file: %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Film dosyası oluşturulamıyor: %@"
          }
        }
      }
    },
    "Circle": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daire"
          }
        }
      }
    },
    "Discard Recording": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydı Sil"
          }
        }
      }
    },
    "Drag to move · Right-click for size and shape": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taşımak için sürükleyin · Boyut ve şekil için sağ tıklayın"
          }
        }
      }
    },
    "Drag to record an area · Click a window · F or Enter for full screen · Esc to cancel": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alan kaydetmek için sürükleyin · Pencere için tıklayın · Tam ekran için F veya Enter · Vazgeçmek için Esc"
          }
        }
      }
    },
    "GIF encoding failed.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF kodlanamadı."
          }
        }
      }
    },
    "Highlight Clicks: Off": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tıklamaları Vurgula: Kapalı"
          }
